---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  postId: string;
}

const { title, description, date, postId } = Astro.props;
const formattedDate = date.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' });
---

<BaseLayout title={`${title} — Ildeberto`} description={description}>
  <div id="page-wrapper">

    <main class="container">
      <section class="content-section" style="border-bottom:none">
        <div class="blog-post-content">
          <nav class="post-nav">
            <a href="/" class="back-link">&larr; Home</a>
            <a href="/blog" class="back-link">&larr; Blog</a>
          </nav>
          <p class="post-meta">
            {formattedDate}
            <span class="post-meta__views">
              <i class="far fa-eye"></i>
              <span
                data-lyket-type="view"
                data-lyket-id={postId}
                data-lyket-namespace="blog"
                data-lyket-template="minimal"
              ></span>
            </span>
          </p>
          <h1>{title}</h1>
          <div class="post-clap">
            <span
              data-lyket-type="clap"
              data-lyket-id={postId}
              data-lyket-namespace="blog"
              data-lyket-template="minimal"
            ></span>
          </div>
          <slot />
        </div>
      </section>

      <div class="copyright">&copy; Ildeberto Silva.</div>
    </main>
  </div>

  <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">&#9788;</button>

  <script is:inline>
    (function () {
      const btn = document.getElementById('theme-toggle');
      const saved = localStorage.getItem('theme');
      if (saved === 'light') { document.body.classList.add('light'); btn.textContent = '🌙'; }
      btn.addEventListener('click', function () {
        const isLight = document.body.classList.toggle('light');
        btn.textContent = isLight ? '🌙' : '☀';
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
      });
    })();
  </script>
</BaseLayout>
