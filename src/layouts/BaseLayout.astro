---
interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Ildeberto Vasconcelos | Engineer',
  description = 'Personal Page of Mobile Software Developer | Flutter Developer | Backend Developer | UI Designer',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <title>{title}</title>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="author" content="Ildeberto Vasconcelos" />
  <meta name="keywords" content="Flutter, Mobile, Programmer, Developer, Software Flutter Developer" />
  <meta name="description" content={description} />
  <link rel="icon" type="image/x-icon" href="/images/favicon.ico" />
  <link rel="stylesheet" href="/assets/css/main.css" />
  <script is:inline src="https://kit.fontawesome.com/a6bb187d37.js" crossorigin="anonymous"></script>
  <script is:inline defer src="https://unpkg.com/@lyket/widget@latest/dist/lyket.js?apiKey=pt_b853182d91a25ae5fe338f1ea89402"></script>
</head>
<body>
  <slot />
</body>
</html>
