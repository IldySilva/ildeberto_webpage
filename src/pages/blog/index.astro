---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const posts = (await getCollection('blog'))
  .filter((p) => !p.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Blog — Ildeberto" description="Writing on Dart, Flutter, and software engineering.">
  <canvas id="bg-canvas"></canvas>

  <div id="page-wrapper">

    <main class="container">

      <section class="hero">
        <a href="/" class="back-link" style="display:block;margin-bottom:1.25rem">&larr; Home</a>
        <h1>Writing</h1>
        <p>Notes on Dart, Flutter, and software engineering.</p>
      </section>

      <section class="content-section" style="border-bottom:none">
        <ul class="blog-list">
          {posts.map((post) => (
            <li class="blog-list__item">
              <a
                href={post.data.externalUrl || `/blog/${post.id}`}
                class="blog-list__title"
                target={post.data.externalUrl ? "_blank" : undefined}
                rel={post.data.externalUrl ? "noopener noreferrer" : undefined}
              >
                {post.data.title}
                {post.data.externalUrl && (
                  <i class="fas fa-external-link-alt" style="font-size:0.7em;margin-left:0.3rem;opacity:0.6" title="External Link"></i>
                )}
              </a>
              <div class="blog-list__meta">
                <span>{post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}</span>
                &middot;
                <span style="display:inline-flex;align-items:center;gap:0.3rem">
                  <i class="far fa-eye" style="opacity:0.6"></i>
                  <span
                    data-lyket-type="view"
                    data-lyket-id={post.id}
                    data-lyket-namespace="blog"
                    data-lyket-template="minimal"
                  ></span>
                </span>
                {post.data.tags.length > 0 && (
                  <span class="post-tags">{post.data.tags.join(', ')}</span>
                )}
              </div>
              {post.data.description && (
                <p class="blog-list__desc">{post.data.description}</p>
              )}
            </li>
          ))}
        </ul>
      </section>

      <div class="copyright">&copy; Ildeberto Silva.</div>
    </main>
  </div>

  <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">&#9788;</button>

  <script is:inline>
    (function () {
      const canvas = document.getElementById('bg-canvas');
      const ctx = canvas.getContext('2d');
      let W, H, shapes;
      function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
      function Shape() { this.reset(true); }
      Shape.prototype.reset = function (initial) {
        this.x = Math.random() * W;
        this.y = initial ? Math.random() * H : (Math.random() < 0.5 ? -120 : H + 120);
        this.r = 40 + Math.random() * 100;
        this.vx = (Math.random() - 0.5) * 0.12;
        this.vy = (Math.random() - 0.5) * 0.12;
        this.alpha = 0.04 + Math.random() * 0.06;
        this.type = Math.random() < 0.5 ? 'circle' : 'rect';
        this.rot = Math.random() * Math.PI * 2;
        this.rotSpeed = (Math.random() - 0.5) * 0.001;
      };
      Shape.prototype.draw = function () {
        ctx.save();
        ctx.globalAlpha = this.alpha;
        ctx.strokeStyle = document.body.classList.contains('light') ? 'rgba(0,0,0,1)' : 'rgba(255,255,255,1)';
        ctx.lineWidth = 1;
        ctx.translate(this.x, this.y);
        ctx.rotate(this.rot);
        if (this.type === 'circle') { ctx.beginPath(); ctx.arc(0, 0, this.r, 0, Math.PI * 2); ctx.stroke(); }
        else { ctx.strokeRect(-this.r / 2, -this.r / 2, this.r, this.r); }
        ctx.restore();
      };
      Shape.prototype.update = function () {
        this.x += this.vx; this.y += this.vy; this.rot += this.rotSpeed;
        if (this.x < -200 || this.x > W + 200 || this.y < -200 || this.y > H + 200) this.reset(false);
      };
      function init() { resize(); shapes = Array.from({ length: 14 }, function () { return new Shape(); }); }
      function loop() { ctx.clearRect(0, 0, W, H); shapes.forEach(function (s) { s.update(); s.draw(); }); requestAnimationFrame(loop); }
      window.addEventListener('resize', resize);
      init(); loop();
    })();

    (function () {
      const btn = document.getElementById('theme-toggle');
      const saved = localStorage.getItem('theme');
      if (saved === 'light') { document.body.classList.add('light'); btn.textContent = '🌙'; }
      btn.addEventListener('click', function () {
        const isLight = document.body.classList.toggle('light');
        btn.textContent = isLight ? '🌙' : '☀';
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
      });
    })();
  </script>
</BaseLayout>
