---
import { readFileSync } from 'fs';
import { resolve } from 'path';
import yaml from 'js-yaml';
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const raw = readFileSync(resolve('content.yml'), 'utf-8');
const data = yaml.load(raw) as any;

const hero = data.hero;
const projects = data.projects || [];
const articles = (data.articles?.items || []).filter((i: any) => i.title && i.url).slice(0, 3);
const articlesSeeMore = data.articles?.see_more || '';
const education = data.education || [];
const languages = data.languages || [];
const skills = data.skills || [];

const blogPosts = (await getCollection('blog'))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<BaseLayout>
  <canvas id="bg-canvas"></canvas>

  <div id="page-wrapper">

    <main class="container">

      <!-- Hero -->
      <section class="hero">
        <h1>Ildeberto Vasconcelos</h1>
        <p set:html={hero.bio}></p>
        <nav class="hero-links">
          {hero.socials.map((s: any) => (
            <a href={s.url} target="_blank" rel="noopener">{s.label}</a>
          ))}
        </nav>
      </section>

      <!-- Projects -->
      <section class="content-section">
        <p class="section-label">Projects</p>
        <ul class="project-list">
          {projects.map((p: any) => (
            <li class="project-item">
              <div class="project-item__header">
                <strong>
                  {p.url
                    ? <a href={p.url} target="_blank" rel="noopener">{p.name}</a>
                    : p.name}
                </strong>
                {p.tags && <span class="project-tags">{p.tags.join(' · ')}</span>}
              </div>
              <p class="project-desc">{p.description}</p>
            </li>
          ))}
        </ul>
      </section>

      <!-- Articles (Medium) -->
      {articles.length > 0 && (
        <section class="content-section">
          <p class="section-label">Articles</p>
          <ul class="link-list">
            {articles.map((a: any) => (
              <li>
                <a href={a.url} target="_blank" rel="noopener">{a.title}</a>
              </li>
            ))}
          </ul>
          {articlesSeeMore && (
            <a href={articlesSeeMore} target="_blank" rel="noopener" class="see-more-link">
              See more &rarr;
            </a>
          )}
        </section>
      )}

      <!-- Blog posts -->
      {blogPosts.length > 0 && (
        <section class="content-section">
          <p class="section-label">Writing</p>
          <ul class="link-list">
            {blogPosts.map((post) => (
              <li>
                <a href={`/blog/${post.id}`}>{post.data.title}</a>
                <span class="post-tags">
                  {post.data.date.toLocaleDateString('en-GB', { year: 'numeric', month: 'short', day: 'numeric' })}
                </span>
              </li>
            ))}
          </ul>
          <a href="/blog" class="see-more-link">All posts &rarr;</a>
        </section>
      )}

      <!-- Education & Languages -->
      <section class="content-section">
        <p class="section-label">Background</p>
        <ul class="journey-list">
          {education.map((e: any) => (
            <li><strong>{e.degree}</strong>, {e.institution} &middot; {e.period}</li>
          ))}
          {languages.length > 0 && (
            <li><strong>Languages</strong> &mdash; {languages.join(', ')}</li>
          )}
        </ul>
      </section>

      <div class="copyright">&copy; Ildeberto Silva.</div>

    </main>
  </div>

  <button class="theme-toggle" id="theme-toggle" aria-label="Toggle theme">&#9788;</button>

  <button class="stack-btn" id="stack-btn">Stack</button>
  <div class="stack-overlay" id="stack-overlay"></div>
  <div class="stack-drawer" id="stack-drawer">
    <button class="stack-drawer__close" id="stack-close">&times;</button>
    <h3>Tech Stack</h3>
    <ul class="skills-list">
      {skills.map((s: any) => (
        <li><strong>{s.label}</strong><span>{s.details}</span></li>
      ))}
    </ul>
  </div>

  <script is:inline>
    (function () {
      const canvas = document.getElementById('bg-canvas');
      const ctx = canvas.getContext('2d');
      let W, H, shapes;
      function resize() { W = canvas.width = window.innerWidth; H = canvas.height = window.innerHeight; }
      function Shape() { this.reset(true); }
      Shape.prototype.reset = function (initial) {
        this.x = Math.random() * W;
        this.y = initial ? Math.random() * H : (Math.random() < 0.5 ? -120 : H + 120);
        this.r = 40 + Math.random() * 100;
        this.vx = (Math.random() - 0.5) * 0.12;
        this.vy = (Math.random() - 0.5) * 0.12;
        this.alpha = 0.04 + Math.random() * 0.06;
        this.type = Math.random() < 0.5 ? 'circle' : 'rect';
        this.rot = Math.random() * Math.PI * 2;
        this.rotSpeed = (Math.random() - 0.5) * 0.001;
      };
      Shape.prototype.draw = function () {
        ctx.save();
        ctx.globalAlpha = this.alpha;
        ctx.strokeStyle = document.body.classList.contains('light') ? 'rgba(0,0,0,1)' : 'rgba(255,255,255,1)';
        ctx.lineWidth = 1;
        ctx.translate(this.x, this.y);
        ctx.rotate(this.rot);
        if (this.type === 'circle') { ctx.beginPath(); ctx.arc(0, 0, this.r, 0, Math.PI * 2); ctx.stroke(); }
        else { ctx.strokeRect(-this.r / 2, -this.r / 2, this.r, this.r); }
        ctx.restore();
      };
      Shape.prototype.update = function () {
        this.x += this.vx; this.y += this.vy; this.rot += this.rotSpeed;
        if (this.x < -200 || this.x > W + 200 || this.y < -200 || this.y > H + 200) this.reset(false);
      };
      function init() { resize(); shapes = Array.from({ length: 14 }, function () { return new Shape(); }); }
      function loop() { ctx.clearRect(0, 0, W, H); shapes.forEach(function (s) { s.update(); s.draw(); }); requestAnimationFrame(loop); }
      window.addEventListener('resize', resize);
      init(); loop();
    })();

    (function () {
      const btn = document.getElementById('theme-toggle');
      const saved = localStorage.getItem('theme');
      if (saved === 'light') { document.body.classList.add('light'); btn.textContent = '🌙'; }
      btn.addEventListener('click', function () {
        const isLight = document.body.classList.toggle('light');
        btn.textContent = isLight ? '🌙' : '☀';
        localStorage.setItem('theme', isLight ? 'light' : 'dark');
      });
    })();

    (function () {
      const btn     = document.getElementById('stack-btn');
      const overlay = document.getElementById('stack-overlay');
      const drawer  = document.getElementById('stack-drawer');
      const close   = document.getElementById('stack-close');
      const openDrawer  = () => { overlay.classList.add('open'); drawer.classList.add('open'); };
      const closeDrawer = () => { overlay.classList.remove('open'); drawer.classList.remove('open'); };
      btn.addEventListener('click', openDrawer);
      overlay.addEventListener('click', closeDrawer);
      close.addEventListener('click', closeDrawer);
    })();
  </script>
</BaseLayout>
